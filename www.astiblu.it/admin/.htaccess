AuthType Basic
AuthName "Asti Blu CMS - Accesso Riservato"
AuthUserFile /web/htdocs/www.astiblu.it/home/.htpasswd
Require valid-user

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://identity.netlify.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.github.com https://unpkg.com https://cdn.jsdelivr.net https://raw.githubusercontent.com https://astiblusubacquea.netlify.app; frame-src 'self'; object-src 'none';"
</IfModule>
